{
  "expo": {
    "name": "Vibe DJ",
    "slug": "vibe-dj",
    "scheme": "spotifyvibe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kurtschillinger.vibedj"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
